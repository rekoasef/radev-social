# Dependencias
node_modules/
.pnpm-store/

# Builds y caché
.next/
next-env.d.ts
dist/
out/
.turbo/
*.tsbuildinfo
coverage/

# Variables de entorno (nunca se suben)
.env
.env.*
!.env.example

# Media generada localmente. La carpeta se versiona vacía: si Docker la creara al montarla,
# quedaría con dueño root y los contenedores no podrían escribir.
media/*
!media/.gitkeep

# Sistema y editores
.DS_Store
Thumbs.db
*:Zone.Identifier
.vscode/*
!.vscode/extensions.json
.idea/

# Scripts de prueba temporales de Claude Code (datos de prueba, limpieza)
**/.scratch/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Archivos de trabajo de la skill de diseño (se versionan solo PRODUCT.md y .impeccable/surfaces/)
**/.impeccable/build/
**/.impeccable/questions/
**/.impeccable/review/
**/.impeccable/mocks/

# Salidas de las pruebas de V0 (MP4, audio, mediciones crudas)
spikes/*/out/
