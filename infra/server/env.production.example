# .env del servidor de producción (fase 4, T11). setup.sh lo copia a ~/radev-social/.env y genera
# los secretos marcados con (auto). Lo marcado COMPLETAR se carga a mano (infra/server/README.md).
# Nunca se sube a git. Diferencias con el .env local: dominios, URL pública con HTTPS, una OAuth
# App de GitHub propia y secretos nuevos.

# --- Dominios (Caddy) ---
APP_DOMAIN=app.gestorlumus.site
MEDIA_DOMAIN=media.gestorlumus.site
# Let's Encrypt avisa acá si un certificado no se puede renovar.
ACME_EMAIL=COMPLETAR

# --- Postgres (solo en la red de Docker: no publica puerto) ---
POSTGRES_USER=radev
POSTGRES_PASSWORD=
POSTGRES_DB=radev_social

# --- Login (Better Auth + GitHub) ---
# (auto) Firma las sesiones y cifra los tokens.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.gestorlumus.site
ALLOWED_EMAILS=COMPLETAR
# Una OAuth App NUEVA, solo para producción (github.com/settings/developers → New OAuth App):
#   Homepage URL: https://app.gestorlumus.site
#   Authorization callback URL: https://app.gestorlumus.site/api/auth/callback/github
GITHUB_CLIENT_ID=COMPLETAR
GITHUB_CLIENT_SECRET=COMPLETAR

# --- Render ---
# (auto) Token de las páginas internas /render (Caddy además las bloquea desde afuera).
RENDER_TOKEN=

# --- IA (los mismos valores que en la compu de desarrollo, entre comillas simples) ---
# Solo una credencial de Claude: este token y nunca ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=COMPLETAR
OPENROUTER_API_KEY=COMPLETAR

# --- Avisos: Telegram (los mismos que en desarrollo) ---
TELEGRAM_BOT_TOKEN=COMPLETAR
TELEGRAM_CHAT_ID=COMPLETAR

# --- Worker ---
LOG_LEVEL=info

# --- Backups (Backblaze B2 u otro S3; infra/backup/README.md) ---
# Vacíos: los backups quedan apagados (se avisa por Telegram). Se completan al crear el bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# Cifra los volcados. Guardala también fuera del servidor: sin ella no se pueden restaurar.
BACKUP_PASSPHRASE=
