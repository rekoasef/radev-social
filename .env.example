# Copiá este archivo como .env y completá los valores. .env nunca se sube a git.

# --- Postgres (contenedor de Docker) ---
POSTGRES_USER=radev
# Generá una con: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=radev_social
# 5433 para no chocar con un Postgres instalado directo en WSL (que usa 5432).
POSTGRES_PORT=5433

# Conexión que usan la app y los scripts desde tu máquina (mismos valores de arriba).
DATABASE_URL=postgres://radev:CAMBIAR_POR_POSTGRES_PASSWORD@localhost:5433/radev_social

# --- Login (Better Auth + GitHub) ---
# Generá uno con: openssl rand -base64 32  (firma las sesiones y cifra los tokens de GitHub)
BETTER_AUTH_SECRET=
# URL pública del panel. En local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Emails que pueden entrar, separados por coma. Tiene que ser un email verificado de tu GitHub.
ALLOWED_EMAILS=
# OAuth App de GitHub (github.com/settings/developers → New OAuth App).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Render ---
# Token de las páginas internas /render (preview de slides; en la Fase 2, el render del worker).
# Generá uno con: openssl rand -hex 24
RENDER_TOKEN=
# Dirección de la web para el worker (render). Vacío = http://localhost:3000; en Docker la fija
# compose.yaml (http://web:3000).
WEB_INTERNAL_URL=

# --- Media ---
# Carpeta de los archivos subidos (assets de las marcas). Vacío = <repo>/media; una ruta
# relativa se toma desde la raíz del repo. En Docker la fija compose.yaml (/data/media).
MEDIA_DIR=

# --- IA: Claude Code (worker) ---
# Token de tu suscripción de Claude para `claude -p` (sin costo extra). Generalo una vez en una
# terminal de WSL con: pnpm --filter @radev/ai exec claude setup-token
# Pegalo entre comillas simples (puede traer # o $): CLAUDE_CODE_OAUTH_TOKEN='sk-ant-oat01-...'
# Probalo con: pnpm --filter @radev/ai smoke
# Solo una credencial de Claude a la vez: si usás este, NO definas ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=

# --- IA: OpenRouter (worker, modelos gratuitos) ---
# API key de openrouter.ai (cuenta gratuita, sin tarjeta). Entre comillas simples.
# Solo se usan modelos ":free": sin saldo cargado no se puede cobrar nada.
# Probala con: pnpm --filter @radev/ai smoke openrouter
OPENROUTER_API_KEY=

# --- Avisos: Telegram (worker; la web solo mira si están) ---
# Token del bot: se crea con @BotFather (/newbot). Secreto: entre comillas simples.
TELEGRAM_BOT_TOKEN=
# Tu chat con el bot: mandale un mensaje y buscalo con getUpdates (ver docs/PROGRESS.md, F4 T6).
TELEGRAM_CHAT_ID=
