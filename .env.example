# Copiá este archivo como .env y completá los valores. .env nunca se sube a git.

# --- Postgres (contenedor de Docker) ---
POSTGRES_USER=radev
# Generá una con: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=radev_social
# 5433 para no chocar con un Postgres instalado directo en WSL (que usa 5432).
POSTGRES_PORT=5433

# Conexión que usan la app y los scripts desde tu máquina (mismos valores de arriba).
DATABASE_URL=postgres://radev:CAMBIAR_POR_POSTGRES_PASSWORD@localhost:5433/radev_social
