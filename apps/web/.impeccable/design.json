  "narrative": {
    "northStar": "La sala de control",
    "overview": "El panel es la sala de control de una emisora: cada marca es un canal, cada post un bloque en la planilla de emisión. Consola de grafito siempre oscura, biseles finos, etiquetas grabadas y datos en mono. El color de cada marca vive solo dentro de su canal; el estado se comunica con lámparas tally con forma y texto.",
    "keyCharacteristics": [
      "Consola de grafito siempre oscura",
      "Plates grabados como títulos de zona",
      "Datos en Geist Mono tabular",
      "Color de marca solo dentro de su canal",
      "Secciones futuras apagadas con su fase"
    ],
    "rules": [
      {
        "name": "La regla del canal propio",
        "body": "El color de una marca solo se pinta dentro de su canal; nunca en el cromo del panel.",
        "section": "colors"
      },
      {
        "name": "La regla de la lámpara",
        "body": "Todo estado lleva forma y texto además del color.",
        "section": "colors"
      },
      {
        "name": "La regla del dato en mono",
        "body": "Horas, códigos, números y colores van en timecode.",
        "section": "typography"
      },
      {
        "name": "La regla del vidrio de consola",
        "body": "Solo las barras fijas usan fondo translúcido con desenfoque.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do titular cada zona con un plate y su conteo al margen",
      "Do mostrar el estado real con una lámpara tally",
      "Do mostrar secciones futuras apagadas con su fase",
      "Do usar timecode para valores",
      "Do controles táctiles de 44px o más"
    ],
    "donts": [
      "Don't usar el color de una marca en el cromo del panel",
      "Don't comunicar estado solo con color",
      "Don't usar barra lateral más grilla de tarjetas",
      "Don't agregar sombras flotantes",
      "Don't agregar modo claro",
      "Don't usar vidrio fuera de las barras fijas"
    ]
  }
